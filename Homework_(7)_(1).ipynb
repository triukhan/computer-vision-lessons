      "source": [
        "inputs = Input(shape=(28, 28, 1))\n",
        "net = Conv2D(32, kernel_size=(3, 3), activation=\"relu\", padding='same')(inputs)\n",
        "net = Flatten()(net)\n",
        "net = Dense(128)(net)\n",
        "outputs = Dense(10, activation=\"softmax\")(net)\n",
        "\n",
        "model = Model(inputs, outputs)\n",
        "model.summary()"
      ]
